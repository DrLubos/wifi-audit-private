# wifi-audit frontend tier: static React app + reverse proxy for the api.
#
# SITE_ADDRESS is set by docker-compose.yml from .env: a domain name turns on
# automatic HTTPS (Let's Encrypt) with an HTTP -> HTTPS redirect; ':80' serves
# plain HTTP; 'localhost' uses Caddy's internal CA.
#
# After editing: docker compose exec frontend caddy reload --config /etc/caddy/Caddyfile

{$SITE_ADDRESS} {
	encode zstd gzip

	# HTTPS only (since 2026-10-17, SITE_ADDRESS = the box's sslip.io name):
	# Caddy redirects http:// to https://, and HSTS keeps a browser from
	# ever sending a request - the write token, the dashboard's cookies -
	# over plain HTTP again (ignored while SITE_ADDRESS is ':80').
	header Strict-Transport-Security "max-age=31536000"

	# Sensor uploads (docs/live-upload.md 9.2): gzip batches of one poll, catch-up
	# batches of 120 polls; nothing larger is accepted (the api checks again).
	# The more specific path is matched before /api/*.
	handle /api/ingest/* {
		request_body {
			max_size 2MB
		}
		reverse_proxy api:8000
	}

	# The api keeps the /api prefix in its own routes: paths pass through unchanged.
	handle /api/* {
		reverse_proxy api:8000
	}

	# Everything else is the single-page app; unknown paths fall back to index.html.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# Vite emits content-hashed files under /assets.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
}
