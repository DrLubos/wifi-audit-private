# wifi-audit server configuration. Copy to .env (gitignored) next to
# docker-compose.yml and fill in; compose reads it automatically.

# PostgreSQL credentials (the api's DATABASE_URL is built from these, so keep
# the password free of @ : / % - or set DATABASE_URL below explicitly).
POSTGRES_USER=wifi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wifi_audit

# Address Caddy serves. A domain name gets automatic HTTPS (DNS must point at
# this box and ports 80/443 must be reachable); ':80' serves plain HTTP.
SITE_ADDRESS=:80

# Optional override; the default is derived from the values above.
#DATABASE_URL=postgresql://wifi:change-me@db:5432/wifi_audit

# Dashboard v2 writes (Settings, event labels, AP classification) need this
# token until login exists; empty = writes disabled. Generate it on the box
# (keep a copy in the password manager), at least 16 characters:
#   echo "WRITE_TOKEN=$(openssl rand -hex 32)" >> .env
WRITE_TOKEN=

# Sensor ingest (docs/live-upload.md). The sensors' tokens live in the
# database (ops/sensor_token.sh create <sensor>), never here. 0 = every
# /api/ingest route answers 503; the sensors keep their data and retry.
INGEST_ENABLED=1
# The refresher's interval (seconds) between rollup refreshes after ingest; it
# waits at least 4 x the last round's duration anyway (at most 20 % of a core).
REFRESH_INTERVAL_S=60

# E-mail notifications (api/app/notify.py; the refresher and the nightly
# backup send them): a sensor without contact or capture for
# NOTIFY_OFFLINE_MIN minutes, a disk below NOTIFY_DISK_MIN_GB, a failed
# nightly backup. Off while NOTIFY_SMTP_HOST or NOTIFY_TO is empty. Any SMTP
# account on port 587 (STARTTLS) or 465 (TLS) - Google Cloud blocks port 25 -
# e.g. smtp.gmail.com with an app password. Put a password with $ or spaces
# in single quotes. Test: docker compose run --rm --no-deps --entrypoint
# python refresher -m app.notify --test
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USER=
NOTIFY_SMTP_PASSWORD=
NOTIFY_FROM=
NOTIFY_TO=
#NOTIFY_OFFLINE_MIN=15
#NOTIFY_DISK_MIN_GB=2

# The batch detectors the refresher runs every night (04:00-06:00 local, the
# last 48 hours); empty = only by hand (docker compose run --rm detect ...).
#REFRESH_DETECTORS=deauth-flood,evil-twin
