# wifi-audit server configuration. Copy to .env (gitignored) next to
# docker-compose.yml and fill in; compose reads it automatically.

# PostgreSQL credentials (the api's DATABASE_URL is built from these, so keep
# the password free of @ : / % - or set DATABASE_URL below explicitly).
POSTGRES_USER=wifi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wifi_audit

# Address Caddy serves. A domain name gets automatic HTTPS (DNS must point at
# this box and ports 80/443 must be reachable); ':80' serves plain HTTP.
SITE_ADDRESS=:80

# Optional override; the default is derived from the values above.
#DATABASE_URL=postgresql://wifi:change-me@db:5432/wifi_audit

# Dashboard v2 writes (Settings, event labels, AP classification) need this
# token until login exists; empty = writes disabled. Generate it on the box
# (keep a copy in the password manager), at least 16 characters:
#   echo "WRITE_TOKEN=$(openssl rand -hex 32)" >> .env
WRITE_TOKEN=
